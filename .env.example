# AI-SNIDS Environment Variables
# Copy this file to .env and fill in any secrets
# NEVER commit .env to version control

# ─── Application Settings ──────────────────────────────────────
APP_NAME=AI-SNIDS
APP_VERSION=1.0.0
DEBUG=false

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/ai_snids.db

# ─── API Settings ──────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000

# ─── Model Settings ────────────────────────────────────────────
MODEL_PATH=ai/model/rf_model.pkl
SCALER_PATH=ai/model/scaler.pkl
ENCODER_PATH=ai/model/label_encoder.pkl
FEATURES_PATH=ai/model/feature_names.json

# ─── Security ──────────────────────────────────────────────────
# IMPORTANT: Private keys are NEVER stored here or in the database.
# ECDH keys are generated fresh per session (ephemeral key exchange).
# This is intentional — see docs/methodology.md for explanation.

# ─── Dataset ───────────────────────────────────────────────────
DATA_DIR=data
MAX_ROWS_PER_CLASS=20000      # Sampling limit per attack class
